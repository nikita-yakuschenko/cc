# Application
# Обязательно. Режим Node.js.
NODE_ENV=development

# Обязательно в production. Хост прослушивания.
HOSTNAME=0.0.0.0

# Обязательно в production. Порт приложения (Dokploy → 3330).
PORT=3330

# Обязательно. PostgreSQL connection string.
# Format: postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public
DATABASE_URL=postgresql://go_avgst:go_avgst@localhost:55433/go_avgst?schema=public

# Обязательно. Публичный URL сервиса (без завершающего /).
APP_URL=http://localhost:3330

# Обязательно для клиента. Должен совпадать с APP_URL в production.
NEXT_PUBLIC_APP_URL=http://localhost:3330

# Обязательно. Секрет Auth.js (≥16 символов). Не использовать NEXT_PUBLIC_.
AUTH_SECRET=replace-with-long-random-secret

# Обязательно для хеширования IP в ClickEvent (≥8 символов).
IP_HASH_SALT=replace-with-ip-hash-salt

# Необязательно. Seed-администратор (идемпотентный seed).
SEED_ADMIN_EMAIL=admin@avgst.ru
SEED_ADMIN_PASSWORD=ChangeMe123!
SEED_ADMIN_NAME=Администратор
